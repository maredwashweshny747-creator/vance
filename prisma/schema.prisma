generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  role          String    @default("ADMIN")
  phone         String?
  canDelete     Boolean   @default(true)
  staffGymId    String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  coach         Coach?
  gym           Gym?
  sessions      Session[]
  gender String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gym {
  id                      String            @id @default(cuid())
  name                    String
  slug                    String            @unique
  logo                    String?
  address                 String?
  phone                   String?
  email                   String?
  website                 String?
  timezone                String            @default("UTC")
  currency                String            @default("EGP")
  plan                    String            @default("STARTER")
  planStatus              String            @default("ACTIVE")
  whatsappMessageTemplate String?
  fighterIdPrefix         String            @default("20006")
  fighterIdSeq            Int               @default(0)
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  ownerId                 String            @unique
  announcements           Announcement[]
  branches                Branch[]
  coaches                 Coach[]
  coachPayrollRuns        CoachPayrollRun[]
  fighterFeedback         FighterFeedback[]
  owner                   User              @relation(fields: [ownerId], references: [id])
  classes                 GymClass[]
  inventory               InventoryItem[]
  leads                   Lead[]
  members                 Member[]
  payments                Payment[]
  payrollRuns             PayrollRun[]
  staff                   Staff[]
  storeSales              StoreSale[]
  workoutPlans            WorkoutPlan[]
}

model Member {
  id               String            @id @default(cuid())
  gymId            String
  fighterId        String
  firstName        String
  lastName         String
  email            String?
  gender           String?
  phone            String?           @unique
  parentPhone      String?
  address          String?
  dateOfBirth      String?
  birthYear        Int?
  photo            String?
  notes            String?
  branchId         String?
  stripeCustomerId String?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendance       ClassAttendance[]
  classBookings    ClassBooking[]
  enrollments      ClassEnrollment[]
  feedback         FighterFeedback[]
  branch           Branch?           @relation(fields: [branchId], references: [id])
  gym              Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  progress         MemberProgress[]
  payments         Payment[]
  workoutPlans     WorkoutPlan[]

  @@unique([gymId, email])
  @@unique([gymId, fighterId])
  @@index([gymId])
  @@index([fighterId])
  @@index([parentPhone])
}

model Coach {
  id                 String            @id @default(cuid())
  gymId              String
  userId             String?           @unique
  firstName          String
  lastName           String
  gender             String?
  email              String
  phone              String?
  photo              String?
  specialties        String?
  bio                String?
  sessionRate        Float             @default(0)
  privateSessionRate Float             @default(0)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  gym                Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user               User?             @relation(fields: [userId], references: [id])
  attendance         CoachAttendance[]
  payrollRuns        CoachPayrollRun[]
  classes            GymClass[]
  workoutPlans       WorkoutPlan[]

  @@unique([gymId, email])
}

model CoachAttendance {
  id              String   @id @default(cuid())
  coachId         String
  classId         String
  date            DateTime
  status          String   @default("ATTENDED")
  method          String   @default("MANUAL")
  markedById      String?
  markedAt        DateTime @default(now())
  assignedCoachId String?
  class           GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  coach           Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, classId, date])
  @@index([classId, date])
  @@index([assignedCoachId])
  @@index([coachId, status, date])
}

model GymClass {
  id              String            @id @default(cuid())
  gymId           String
  coachId         String?
  name            String
  description     String?
  category        String?
  type            String            @default("GROUP")
  daysOfWeek      String[]          @default([])
  isOneTime       Boolean           @default(false)
  sessionDate     DateTime?
  startTimeOfDay  String            @default("18:00")
  duration        Int               @default(60)
  capacity        Int               @default(20)
  price           Float             @default(0)
  durationDays    Int               @default(30)
  location        String?
  color           String?           @default("#ffc700")
  branchId        String?
  status          String            @default("PENDING")
  rejectionNote   String?
  isActive        Boolean           @default(true)
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  attendance      ClassAttendance[]
  bookings        ClassBooking[]
  enrollments     ClassEnrollment[]
  offers          ClassOffer[]
  coachAttendance CoachAttendance[]
  branch          Branch?           @relation(fields: [branchId], references: [id])
  coach           Coach?            @relation(fields: [coachId], references: [id])
  gym             Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payments        Payment[]
}

model ClassOffer {
  id        String   @id @default(cuid())
  classId   String
  months    Int?
  sessions  Int?
  price     Float
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  class     GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model ClassEnrollment {
  id             String            @id @default(cuid())
  memberId       String
  classId        String
  status         String            @default("ACTIVE")
  startDate      DateTime          @default(now())
  endDate        DateTime?
  addedById      String?
  lastAction     String?
  lastActionById String?
  lastActionAt   DateTime?
  sessionCount   Int?
  totalSessions  Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  attendance     ClassAttendance[]
  class          GymClass          @relation(fields: [classId], references: [id])
  member         Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payments       Payment[]
}

model ClassAttendance {
  id           String          @id @default(cuid())
  classId      String
  enrollmentId String
  memberId     String
  date         DateTime
  status       String          @default("ATTENDED")
  method       String          @default("MANUAL")
  reason       String?
  markedById   String?
  markedAt     DateTime        @default(now())
  class        GymClass        @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollment   ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  member       Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
  @@index([classId, date])
  @@index([memberId])
}

model ClassBooking {
  id       String   @id @default(cuid())
  classId  String
  memberId String
  status   String   @default("CONFIRMED")
  bookedAt DateTime @default(now())
  class    GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([classId, memberId])
}

model Payment {
  id                    String           @id @default(cuid())
  gymId                 String
  memberId              String?
  classId               String?
  enrollmentId          String?
  amount                Float
  originalAmount        Float?
  discountType          String?          @default("NONE")
  discountValue         Float?           @default(0)
  currency              String           @default("EGP")
  type                  String
  status                String           @default("PENDING")
  method                String?
  proofPhoto            String?
  description           String?
  branchId              String?
  stripePaymentIntentId String?
  stripeInvoiceId       String?
  dueDate               DateTime?
  paidAt                DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  branch                Branch?          @relation(fields: [branchId], references: [id])
  class                 GymClass?        @relation(fields: [classId], references: [id])
  enrollment            ClassEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  gym                   Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member                Member?          @relation(fields: [memberId], references: [id])

  @@index([gymId, paidAt])
  @@index([gymId, status])
  @@index([memberId])
  @@index([classId])
  @@index([enrollmentId])
}

model Announcement {
  id        String   @id @default(cuid())
  gymId     String
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model Lead {
  id           String            @id @default(cuid())
  gymId        String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  source       String            @default("WALK_IN")
  status       String            @default("NEW")
  assignedTo   String?
  notes        String?
  trialStart   DateTime?
  trialEnd     DateTime?
  followUpAt   DateTime?
  convertedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  gym          Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  interactions LeadInteraction[]

  @@index([gymId, status])
  @@index([gymId, createdAt])
}

model LeadInteraction {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  note      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Staff {
  id          String       @id @default(cuid())
  gymId       String
  firstName   String
  lastName    String
  email       String
  phone       String?
  role        String       @default("STAFF")
  salary      Float        @default(0)
  salaryType  String       @default("MONTHLY")
  isActive    Boolean      @default(true)
  branchId    String?
  joinDate    DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  payrollRuns PayrollRun[]
  branch      Branch?      @relation(fields: [branchId], references: [id])
  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, email])
}

model PayrollRun {
  id         String    @id @default(cuid())
  gymId      String
  staffId    String
  month      Int
  year       Int
  baseSalary Float
  commission Float     @default(0)
  bonus      Float     @default(0)
  deductions Float     @default(0)
  total      Float
  status     String    @default("PENDING")
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  gym        Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, month, year])
}

model CoachPayrollRun {
  id                  String    @id @default(cuid())
  gymId               String
  coachId             String
  month               Int
  year                Int
  sessionCount        Int       @default(0)
  sessionRate         Float     @default(0)
  privateSessionCount Int       @default(0)
  privateSessionRate  Float     @default(0)
  bonus               Float     @default(0)
  deductions          Float     @default(0)
  total               Float     @default(0)
  status              String    @default("PENDING")
  paidAt              DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  coach               Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  gym                 Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([coachId, month, year])
}

model Branch {
  id        String     @id @default(cuid())
  gymId     String
  name      String
  address   String?
  phone     String?
  email     String?
  manager   String?
  sports    String[]   @default([])
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  gym       Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  classes   GymClass[]
  members   Member[]
  payments  Payment[]
  staff     Staff[]
}

model InventoryItem {
  id          String      @id @default(cuid())
  gymId       String
  name        String
  sku         String?
  category    String      @default("SUPPLEMENT")
  costPrice   Float       @default(0)
  sellPrice   Float       @default(0)
  stock       Int         @default(0)
  lowStockAt  Int         @default(5)
  barcode     String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  gym         Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  sales       StoreSale[]
}

model StoreSale {
  id        String        @id @default(cuid())
  gymId     String
  itemId    String
  memberId  String?
  quantity  Int           @default(1)
  unitPrice Float
  total     Float
  method    String        @default("CASH")
  soldAt    DateTime      @default(now())
  gym       Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model MemberProgress {
  id         String   @id @default(cuid())
  memberId   String
  weight     Float?
  bodyFat    Float?
  chest      Float?
  waist      Float?
  hips       Float?
  arms       Float?
  notes      String?
  recordedAt DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model FighterFeedback {
  id        String   @id @default(cuid())
  gymId     String
  memberId  String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, isRead])
}

model WorkoutPlan {
  id          String         @id @default(cuid())
  gymId       String
  memberId    String
  coachId     String?
  title       String
  description String?
  goal        String?
  weeks       Int            @default(4)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  exercises   PlanExercise[]
  coach       Coach?         @relation(fields: [coachId], references: [id])
  gym         Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model PlanExercise {
  id     String      @id @default(cuid())
  planId String
  name   String
  sets   Int         @default(3)
  reps   String      @default("10-12")
  rest   Int         @default(60)
  day    Int         @default(1)
  notes  String?
  plan   WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}
